{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // oxlint has no separate "react-hooks" plugin: the hooks rules live in "react" and are enabled
  // explicitly below. typescript/unicorn/oxc are oxlint's defaults (listing plugins replaces them).
  "plugins": ["react", "jsx-a11y", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "warn",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "typescript/no-explicit-any": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [".next/**", ".next-e2e/**", "next-env.d.ts"]
}
