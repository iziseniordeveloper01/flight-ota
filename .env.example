POSTGRES_USER=ota
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=flight_ota
DATABASE_URL=postgresql://ota:change_me_local@127.0.0.1:5432/flight_ota?schema=public
REDIS_URL=redis://127.0.0.1:6379
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Flight supplier: mock (offline, default) | duffel (needs a Duffel test token)
SUPPLIER=mock
DUFFEL_ACCESS_TOKEN=duffel_test_replace_me
# REQUIRED. AES-256-GCM key for passenger PII at rest (DOB, passport numbers): base64 of exactly 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it makes stored passenger data unreadable.
BOOKING_DATA_KEY=generate_with_node_crypto_32_bytes_base64
# Travel insurance provider: demo (only value; clearly-labelled demo plan, no real policy)
INSURANCE_PROVIDER=demo
# Brand shown in emails and the payment checkout
BRAND_NAME=SkyFare

# ---- Pricing (business decisions: config, not code) ----
# Customers are charged in this currency (only INR is supported: Razorpay India)
CHARGE_CURRENCY=INR
# Markup on the fare: fixed amount in paise + percent (max 2 decimals). 0 = none.
MARKUP_FIXED_MINOR=0
MARKUP_PERCENT=0
# Cancellation fee in paise — stored for the cancellation flow (Step 9), not used yet
CANCELLATION_FEE_MINOR=0
# FX risk buffer on converted prices (not markup): rate × (1 + buffer%). Supplier prices in other
# currencies are converted with Frankfurter (free, no key), rounded UP to the whole rupee.
FX_BUFFER_PERCENT=2
FX_API_URL=https://api.frankfurter.dev

# ---- Payments ----
# demo (no money; POST /bookings/:id/confirm-demo) | razorpay | fake (in-process test double, NODE_ENV=test only)
PAYMENT_PROVIDER=demo
# Razorpay keys (Dashboard → Settings → API Keys; test keys start with rzp_test_). Required when PAYMENT_PROVIDER=razorpay.
# Live keys (rzp_live_) are refused unless NODE_ENV=production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set on the webhook (Dashboard → Webhooks) for POST /v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_URL=https://api.razorpay.com

# ---- Background jobs (BullMQ on REDIS_URL) ----
# Run the queue workers inside the API process (dev default). Production runs a separate worker process.
WORKERS_ENABLED=true
# Redis key prefix of the queues (keeps dev, tests and Playwright apart)
QUEUE_PREFIX=bull

# ---- Email (SMTP) ----
# Local: Mailpit from docker-compose (UI http://127.0.0.1:8025). Production: SES SMTP (port 587 + SMTP_USER/PASS).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SkyFare <bookings@skyfare.test>"

# Web (Next.js). NEXT_PUBLIC_* values are public (inlined into the browser bundle) and read at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
# Server-only (route handlers + server components, never sent to the browser): how the Next server
# reaches the API, e.g. a private network address. Optional; defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
# WEB_ORIGIN (above) is also read by the web server: booking POST/PUT calls whose Origin header is
# not exactly this origin get 403 (CSRF defence).
NEXT_PUBLIC_BRAND_NAME=SkyFare
